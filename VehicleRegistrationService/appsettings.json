{
  "Serilog": {
    "Using": [ "Serilog", "Serilog.Sinks.Async", "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Exceptions", "Serilog.Sinks.Seq", "Serilog.Sinks.Grafana.Loki" ],
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "JWT": {
    "ValidAudience": "http://localhost:7299",
    "ValidIssuer": "http://localhost:7299",
  },
  "FeatureManagement": {
    "JwtJtiReplayControl": true,
    "DisableConfEndpoint": true,
    "DisableEnvEndpoint" : true
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  }
}
